generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model PriceSnapshot {
  id          Int      @id @default(autoincrement())
  instrumentId String
  timestamp   DateTime
  price       Float
  bid         Float
  ask         Float
  volume      Float
  dailyVolume Float    @default(0)
  isReset     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([instrumentId, timestamp])
  @@index([instrumentId, createdAt])
}

model DailyVolume {
  id           Int      @id @default(autoincrement())
  instrumentId String
  date         String
  totalVolume  Float    @default(0)
  firstSnapshot String?
  lastSnapshot String?
  snapshotCount Int     @default(0)
  createdAt    DateTime @default(now())

  @@unique([instrumentId, date])
  @@index([date])
  @@index([instrumentId])
}

model HistoricalPrice {
  id           Int      @id @default(autoincrement())
  instrumentId String
  date         String
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float    @default(0)
  createdAt    DateTime @default(now())

  @@unique([instrumentId, date])
  @@index([date])
}

model MarketSession {
  id        Int      @id @default(autoincrement())
  date      String   @unique
  openTime  DateTime
  closeTime DateTime?
  status    String   @default("open")
  createdAt DateTime @default(now())
}
