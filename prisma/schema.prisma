generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/custom.db"
}

model AppState {
  id        Int      @id @default(1)
  instruments Json?
  config    Json?
  position  Json?
  mepRate   Float?
  cclRate   Float?
  updatedAt DateTime @updatedAt
}

model IolVolumeSnapshot {
  id        Int      @id @default(1)
  date      DateTime
  ticker    String
  volumen   Int
  bid       Float?
  ask       Float?
  createdAt DateTime @default(now())

  @@unique([date, ticker])
  @@index([date])
  @@index([ticker])
}

model PriceSnapshot {
  id        Int      @id @default(1)
  ticker    String
  price     Float
  tem       Float?
  tir       Float?
  timestamp DateTime
  spread    Float?
  volume    Int?
  iolBid    Float?
  iolAsk    Float?

  @@index([ticker])
  @@index([timestamp])
  @@index([ticker, timestamp])
}

model DailyOHLC {
  id           Int      @id @default(1)
  date         DateTime
  ticker       String
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Int      @default(0)
  iolVolume    Int      @default(0)
  temOpen      Float?
  temHigh      Float?
  temLow       Float?
  temClose     Float?
  spreadAvg    Float?
  vpV          Float?
  daysToExpiry Int?

  @@unique([date, ticker])
  @@index([date])
  @@index([ticker])
}

// Tabla nueva para el Motor de Señales
model PriceLevel {
  id            Int      @id @default(1)
  ticker        String
  support       Float
  resistance    Float
  averageVolume Float
  calculatedAt  DateTime @default(now())

  @@index([ticker])
  @@index([calculatedAt])
}

model CountryRisk {
  id        Int      @id @default(1)
  value     Float
  source    String?
  updatedAt DateTime @updatedAt
}