// ═══════════════════════════════════════════════════════════════════
// ARB//RADAR V4.0 BLINDADO — Prisma Schema
// Complete schema for state persistence, IOL volume snapshots,
// price history (Historico tab), country risk, and S/R calculations.
//
// V4.0.1: Expanded DailyOHLC + PriceSnapshot + CountryRisk
// All fields needed by /api/price-history, /api/country-risk,
// and /api/market-truth are now present.
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// V3.0 — AppState: Single-row persistence for Zustand store
// Stores the entire app state as JSON strings in one row (id='main').
// This is the DB persistence layer for the Zustand store.
// ═══════════════════════════════════════════════════════════════════
model AppState {
  id              String    @id          // Always 'main'
  instruments     String    @default("[]")  // JSON array of instruments
  config          String    @default("{}")  // JSON object of config
  position        String?                  // JSON object or null
  transactions    String    @default("[]")  // JSON array
  lastUpdate      String?                  // ISO timestamp
  rawInput        String?                  // Raw pasted input
  mepRate         Float?                   // MEP dollar rate
  cclRate         Float?                   // CCL dollar rate
  liveActive      Boolean   @default(false)
  iolLevel2Online Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// V3.3 — IOL Volume Snapshots (replaces JSON file storage)
// Persists montoOperado, bid, ask per ticker per date.
// ═══════════════════════════════════════════════════════════════════
model IolVolumeSnapshot {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD (Argentina trading date)
  ticker    String   // e.g. "T15J7", "S12E5"
  volumen   Float    @default(0) // montoOperado en ARS
  bid       Float    @default(0) // best IOL bid price
  ask       Float    @default(0) // best IOL ask price
  createdAt DateTime @default(now())

  // Unique constraint: one snapshot per ticker per date
  @@unique([date, ticker])
  // Index for querying by date range
  @@index([date])
  @@index([ticker])
}

// ═══════════════════════════════════════════════════════════════════
// Price History Models (for /api/price-history)
// V4.0.1: Expanded with TEM OHLC, IOL volume, and spread fields
// ═══════════════════════════════════════════════════════════════════

model PriceSnapshot {
  id        String   @id @default(cuid())
  ticker    String   // e.g. "S30A6", "T15J7"
  price     Float    // price per $1 VN
  tem       Float    @default(0) // monthly rate
  tir       Float    @default(0) // annual rate
  source    String   @default("live") // "live" | "manual"
  timestamp DateTime @default(now())
  // V4.0.1: Additional fields for enriched snapshots
  spread    Float    @default(0) // bid-ask spread
  volume    Float    @default(0) // data912 volume
  iolVolume Float    @default(0) // IOL cantidadOperada
  iolBid    Float    @default(0) // IOL best bid
  iolAsk    Float    @default(0) // IOL best ask

  @@index([ticker])
  @@index([timestamp])
  @@index([ticker, timestamp])
}

model DailyOHLC {
  id            String @id @default(cuid())
  date          String // YYYY-MM-DD
  ticker        String // e.g. "S30A6", "T15J7"
  open          Float  @default(0)
  high          Float  @default(0)
  low           Float  @default(0)
  close         Float  @default(0)
  tem           Float  @default(0)   // average TEM for the day
  volume        Float  @default(0)   // data912 volume (Last-Value-Wins: accumulated daily)
  // V4.0.1: TEM OHLC for HistoricoTab TEM charts
  temOpen       Float  @default(0)   // TEM at market open
  temClose      Float  @default(0)   // TEM at market close
  temHigh       Float  @default(0)   // max TEM intraday
  temLow        Float  @default(0)   // min TEM intraday
  // V4.0.1: IOL enrichment fields
  iolVolume     Float  @default(0)   // IOL cantidadOperada (Last-Value-Wins: accumulated daily)
  spreadAvg     Float  @default(0)   // average bid-ask spread (snapshot-counter weighted)
  // V4.0.7: Snapshot counter for correct spreadAvg weighting
  snapshotCount Int    @default(1)   // number of daemon ticks that updated this record today

  @@unique([date, ticker])
  @@index([date])
  @@index([ticker])
}

// ═══════════════════════════════════════════════════════════════════
// V4.0.1 — Country Risk: Persisted value for fallback
// Used by /api/country-risk and /api/market-truth
// ═══════════════════════════════════════════════════════════════════
model CountryRisk {
  id        String   @id          // Always 'main'
  value     Int      @default(0)  // Riesgo País in basis points
  source    String   @default("unknown") // 'argentinadatos' | 'bondterminal' | etc.
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// V7.0-FASE3-HC — IntradayVolumeBlock: Volume per 5-min block (Horario Corregido)
//
// Stores the volume traded in each 5-minute block of the session.
// Used by calculateVolumeVelocity() to compute the Volume Rate of
// Change (VROC) — comparing current block flow against its own
// historical average for the same time slot.
//
// Session: 10:00–18:00 Argentina = 96 blocks of 5 minutes
// blockIndex: 0 = 10:00–10:05, 1 = 10:05–10:10, ..., 95 = 17:55–18:00
// ═══════════════════════════════════════════════════════════════════
model IntradayVolumeBlock {
  id         String @id @default(cuid())
  date       String // YYYY-MM-DD (Argentina trading date)
  ticker     String // e.g. "T15J7", "S12E5"
  blockIndex Int    // 0-95 (5-min blocks in 10:00-18:00 session, 96 total)
  blockStart String // "HH:MM" start of block (e.g. "10:00", "10:05")
  volume     Float  @default(0) // Notional ARS volume in this block (data912)
  iolVolume  Float  @default(0) // IOL cantidadOperada delta in this block
  tradeCount Int    @default(0) // Number of trades in this block (if available)

  @@unique([date, ticker, blockIndex])
  @@index([date, ticker])
  @@index([date])
}

// ═══════════════════════════════════════════════════════════════════
// V7.0-FASE3 — CurveSpreadHistory: Spread de TEM entre pares compañeros
//
// Persiste el spread de TEM entre pares de instrumentos del mismo
// cluster de curva compañera. Permite calcular el promedio móvil
// de 5 días y el desvío estándar para detectar anomalías de curva.
//
// tickerA = instrumento de menor plazo, tickerB = instrumento de mayor plazo
// spreadTEM = TEM_B - TEM_A (siempre positivo en curva normal)
// ═══════════════════════════════════════════════════════════════════
model CurveSpreadHistory {
  id        String @id @default(cuid())
  date      String // YYYY-MM-DD (Argentina trading date)
  tickerA   String // Menor plazo del par compañero
  tickerB   String // Mayor plazo del par compañero
  clusterId String // Companion cluster ID (e.g. "LECORTAS")
  spreadTEM Float  @default(0) // TEM_B - TEM_A en porcentaje (ej. 0.12 = 12pb)
  temA      Float  @default(0) // TEM del tickerA ese día
  temB      Float  @default(0) // TEM del tickerB ese día

  @@unique([date, tickerA, tickerB])
  @@index([clusterId, date])
  @@index([date])
}
